{
  "name": "unngl",
  "version": "0.1.0",
  "private": false,
  "license": "AGPL-3.0-or-later",
  "description": "UnNGL — free, open source, privacy-first anonymous messages. The hint is the sender's whole colour palette.",
  "repository": {
    "type": "git",
    "url": "https://github.com/AlshyTacohcysp/UnNGL"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "tsx --env-file-if-exists=.env.local --env-file-if-exists=.env scripts/seed-demo.ts",
    "samples": "tsx scripts/samples.ts",
    "assets": "tsx scripts/assets.ts"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.2.5",
    "@fontsource/instrument-serif": "^5.2.5",
    "nanoid": "^5.0.9",
    "next": "^15.5.26",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "postcss": "^8.5.28"
  }
}
