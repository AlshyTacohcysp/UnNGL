# ---------------------------------------------------------------------------
# UnNGL configuration. Copy to .env.local for development, or set these as
# real environment variables in production. Everything has a working default
# EXCEPT SESSION_SECRET, which is mandatory in production on purpose.
#
# The server audits these at boot and prints a warning for any setting that
# would weaken the instance. See docs/en/security.md.
# ---------------------------------------------------------------------------

# Where the app is reachable. Used for links in emails and OAuth redirects.
# In production this MUST be https:// — session cookies are marked Secure.
NEXT_PUBLIC_ORIGIN=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://unngl.link

# --- required in production -------------------------------------------------
# 32+ random bytes. Rotating it logs everyone out and invalidates stored
# digests. Generate with:  openssl rand -base64 48
SESSION_SECRET=

# Set to 1 only to run a throwaway instance with the development defaults.
# Never in production.
# ALLOW_INSECURE_DEFAULTS=

# --- database ---------------------------------------------------------------
# One SQLite file. Back it up by copying it. Must be a writable path on a
# persistent volume.
DATABASE_PATH=./data/unngl.sqlite

# --- sessions ---------------------------------------------------------------
SESSION_DAYS=30

# --- email ------------------------------------------------------------------
# console = print the login code to the server log (no setup needed)
# smtp    = actually send it
#
# SECURITY: with `console` in production, codes are never emailed — the
# operator reads them from the log. The code is still never returned in an API
# response. The server prints a warning if this is left on in production.
MAIL_TRANSPORT=console
MAIL_FROM=UnNGL <no-reply@unngl.link>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CONTACT_EMAIL=hello@unngl.link

# --- OAuth (all optional; email login always works) --------------------------
# Callback URL: {NEXT_PUBLIC_ORIGIN}/api/auth/oauth/<provider>/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Facebook Login. This is also the Instagram path: Meta retired the Instagram
# Basic Display API in Dec 2024, so Instagram accounts sign in through
# Facebook Login, which can return an Instagram username.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- development conveniences ----------------------------------------------
# Return the login code in the API response so the sign-in form can show it.
# Requires NODE_ENV != production AND MAIL_TRANSPORT=console. It is an account
# takeover primitive if it ever runs in production, which is why it is opt-in.
# EXPOSE_DEV_CODES=1

# --- deployment switches ---------------------------------------------------
# Trust X-Forwarded-For / CF-Connecting-IP. ONLY enable this when a proxy you
# control is the sole path to the app. If the app is directly reachable and this
# is on, anyone can forge a header and walk through every per-IP rate limit.
# With it off (the default), UnNGL cannot identify clients and deliberately
# fails closed: everyone shares one bucket.
# TRUSTED_PROXY=1

# Send Strict-Transport-Security. Only turn this on once the domain is
# permanently HTTPS — browsers honour it for two years.
# ENABLE_HSTS=1

# Allow GET /api/health?detail=1 to report version, schema and user count.
# Off in production by default so the endpoint cannot be used for
# reconnaissance.
# HEALTH_DETAIL=1

# --- limits -----------------------------------------------------------------
MAX_MESSAGE_CHARS=1000
MAX_IMAGE_BYTES=2097152
MAX_IMAGE_EDGE=1024
SENDS_PER_INBOX_PER_HOUR=10
SENDS_PER_IP_PER_HOUR=30
INBOXES_PER_USER=5

# How long a hint's source photo survives before the deletion sweep removes it.
HINT_IMAGE_RETENTION_DAYS=7
