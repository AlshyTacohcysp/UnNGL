# ---------------------------------------------------------------------------
# UnNGL configuration. Copy to .env.local for development, or set these as
# real environment variables in production. Everything has a working default
# EXCEPT SESSION_SECRET, which is mandatory in production on purpose.
#
# The server audits these at boot and prints a warning for any setting that
# would weaken the instance. See docs/en/security.md.
# ---------------------------------------------------------------------------

# Where the app is reachable, as users type it. Used for links in emails, OAuth
# callback URLs, and the same-origin check.
# In production this MUST be https:// — session cookies are marked Secure.
# This is a RUNTIME setting: set it here and restart, no rebuild needed.
NEXT_PUBLIC_ORIGIN=http://localhost:3000

# --- required in production -------------------------------------------------
# 32+ random bytes. Rotating it logs everyone out and invalidates stored
# digests. Generate with:  openssl rand -base64 48
SESSION_SECRET=

# Set to 1 only to run a throwaway instance with the development defaults.
# Never in production.
# ALLOW_INSECURE_DEFAULTS=

# --- database ---------------------------------------------------------------
# A Postgres connection string. Production is Vercel + Supabase: paste the
# Supabase connection string here, and use the TRANSACTION POOLER URL
# (port 6543) rather than the direct one (port 5432) — a serverless function
# opens a fresh connection per request and would otherwise exhaust the tier's
# connection limit immediately.
#
# For local development without installing Postgres, run `npm run db:serve`
# and use the URL it prints.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:55432/postgres

# Connections per instance. Free tiers cap concurrent connections hard, so this
# is deliberately small. Raise it only if your provider gives you room.
DB_POOL_MAX=3

# --- sessions ---------------------------------------------------------------
SESSION_DAYS=30

# --- email ------------------------------------------------------------------
# console = print the login code to the server log (no setup needed)
# smtp    = actually send it
#
# SECURITY: with `console` in production, codes are never emailed — the
# operator reads them from the log. The code is still never returned in an API
# response. The server prints a warning if this is left on in production.
MAIL_TRANSPORT=console
MAIL_FROM=UnNGL <no-reply@unngl.link>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CONTACT_EMAIL=hello@unngl.link

# --- OAuth (all optional; email login always works) --------------------------
# Callback URL: {NEXT_PUBLIC_ORIGIN}/api/auth/oauth/<provider>/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Facebook Login. This is also the Instagram path: Meta retired the Instagram
# Basic Display API in Dec 2024, so Instagram accounts sign in through
# Facebook Login, which can return an Instagram username.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Instagram. This is the flow behind the "send from Instagram" action on a
# send page: it takes your profile photo, extracts the six colours from it, and
# throws the photo away. The two values come from the Meta developer console
# (Instagram > Instagram login with Facebook), not from Google.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

# --- development conveniences ----------------------------------------------
# Return the login code in the API response so the sign-in form can show it.
# Requires NODE_ENV != production AND MAIL_TRANSPORT=console. It is an account
# takeover primitive if it ever runs in production, which is why it is opt-in.
# EXPOSE_DEV_CODES=1

# --- deployment switches ---------------------------------------------------
# Trust X-Forwarded-For / CF-Connecting-IP. ONLY enable this when a proxy you
# control is the sole path to the app. If the app is directly reachable and this
# is on, anyone can forge a header and walk through every per-IP rate limit.
# With it off (the default), UnNGL cannot identify clients and deliberately
# fails closed: everyone shares one bucket.
# TRUSTED_PROXY=1

# Send Strict-Transport-Security. Only turn this on once the domain is
# permanently HTTPS — browsers honour it for two years.
#
# BUILD-TIME, not runtime: next.config is not shipped in the standalone output,
# so setting this in .env and restarting does nothing. Use:
#   ENABLE_HSTS=1 npm run build
#   docker build --build-arg ENABLE_HSTS=1 -t unngl:latest .
# The server prints at boot whether HSTS was compiled in.
# ENABLE_HSTS=1

# Allow GET /api/health?detail=1 to report version, schema and user count.
# Off in production by default so the endpoint cannot be used for
# reconnaissance.
# HEALTH_DETAIL=1

# --- limits -----------------------------------------------------------------
# Attempts to guess a login code, per IP, per window. The window is 15 min.
LOGIN_ATTEMPTS_PER_IP=5
# Remote photo fetches (the profile-photo-by-link path), per IP, per window.
MEDIA_FETCHES_PER_IP_PER_HOUR=10
MAX_MESSAGE_CHARS=1000
MAX_IMAGE_BYTES=2097152
MAX_IMAGE_EDGE=1024
SENDS_PER_INBOX_PER_HOUR=10
SENDS_PER_IP_PER_HOUR=30
INBOXES_PER_USER=5

# How long a hint's source photo survives before the deletion sweep removes it.
HINT_IMAGE_RETENTION_DAYS=7

# --- reverse proxy -----------------------------------------------------------
# Set to 1 when running behind a proxy that sets X-Forwarded-For — Vercel
# does. Left at 0, the client IP falls back to a constant and every visitor
# shares one rate-limit bucket, which makes the per-IP send limits useless.
TRUSTED_PROXY=0
# --- HSTS ---------------------------------------------------------------------
# NOT settable here. HSTS is decided at build time by ENABLE_HSTS, which
# next.config reads, and compiled into the UNNGL_HSTS the running server
# reads. Setting UNNGL_HSTS in the environment has no effect: next.config
# overwrites it at build. To turn HSTS on, build with ENABLE_HSTS=1.
# See docs/en/deployment.md.
# ENABLE_HSTS=1
