# ---------------------------------------------------------------------------
# UnNGL configuration. Copy to .env.local for development, or set these as
# real environment variables in production. Everything has a working default
# EXCEPT SESSION_SECRET, which is mandatory in production on purpose.
# ---------------------------------------------------------------------------

# Where the app is reachable. Used for links in emails and OAuth redirects.
NEXT_PUBLIC_ORIGIN=http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://unngl.link

# --- required in production -------------------------------------------------
# 32+ random bytes. Rotating it logs everyone out and invalidates stored
# digests. Generate with:  openssl rand -base64 48
SESSION_SECRET=

# Set to 1 only to run a throwaway instance with the development defaults.
# ALLOW_INSECURE_DEFAULTS=

# --- database ---------------------------------------------------------------
# One SQLite file. Back it up by copying it.
DATABASE_PATH=./data/unngl.sqlite

# --- sessions ---------------------------------------------------------------
SESSION_DAYS=30

# --- email ------------------------------------------------------------------
# console = print the login code to the server log (default, no setup needed)
# smtp    = actually send it
MAIL_TRANSPORT=console
MAIL_FROM=UnNGL <no-reply@unngl.link>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CONTACT_EMAIL=hello@unngl.link

# --- OAuth (all optional; email login always works) --------------------------
# Callback URL: {NEXT_PUBLIC_ORIGIN}/api/auth/oauth/<provider>/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Facebook Login. This is also the Instagram path: Meta retired the Instagram
# Basic Display API in Dec 2024, so Instagram accounts sign in through
# Facebook Login, which can return an Instagram username.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- limits -----------------------------------------------------------------
MAX_MESSAGE_CHARS=1000
MAX_IMAGE_BYTES=2097152
MAX_IMAGE_EDGE=1024
SENDS_PER_INBOX_PER_HOUR=10
SENDS_PER_IP_PER_HOUR=30
INBOXES_PER_USER=5

# How long a hint's source photo survives before the deletion sweep removes it.
HINT_IMAGE_RETENTION_DAYS=7
